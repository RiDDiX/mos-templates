# UniversalLocal RMM on MOS. Fill in every empty value before you deploy.
# The passwords are read on the first start; changing them later needs the
# matching service changed as well.

# image tag: the release you run
ULRMM_VERSION=1.04.11.2026
# data of all services. ./data is the stack folder in the Docker appdata path
# of MOS, an absolute path works as well. Keep it off network shares (PostgreSQL)
ULRMM_DATA=./data
# API name, the agents and the dashboard talk to it
API_DOMAIN=api.example.com
# dashboard name
APP_DOMAIN=rmm.example.com
# MeshCentral name
MESH_DOMAIN=mesh.example.com
# root domain of the three names; subject of the self-signed certificate.
# All three names have to reach HTTPS_PORT of this server as port 443.
ROOT_DOMAIN=example.com
# own: put fullchain.pem and privkey.pem into ULRMM_DATA/certs before the first start
# selfsigned: nginx makes a wildcard cert, the agents then skip the certificate check
ULRMM_TLS=own
# published ports of nginx. MOS serves its own web UI on 80, and on 443 with HTTPS on
HTTP_PORT=8080
HTTPS_PORT=443
# e-mail of the dashboard superuser and the MeshCentral account
ADMIN_EMAIL=admin@example.com
# dashboard superuser, created on the first start only
ADMIN_USER=admin
# password of that superuser, read on the first start only; empty afterwards is fine
ADMIN_PASSWORD=
# password of the postgres role ulrmm (database ulrmm)
POSTGRES_PASSWORD=
# redis requirepass
REDIS_PASSWORD=
# password of the postgres role meshcentral (database meshcentral)
MESH_DB_PASSWORD=
# MeshCentral account the server logs in with
MESH_USERNAME=ulrmm-mesh
# password of that account, created on the first start
MESH_PASSWORD=
# uwsgi worker processes of the api service
UWSGI_WORKERS=6
# log level of the Django services (stdout)
ULRMM_LOG_LEVEL=INFO
# script library, cloned by init; init only warns when the clone fails
ULRMM_SCRIPTS_REPO=https://github.com/RiDDiX/ulrmm-scripts.git
# token for ULRMM_SCRIPTS_REPO, empty for anonymous
ULRMM_SCRIPTS_TOKEN=
# agent source of the agents service. Build the Linux and macOS agents once
# after the first start, in the Docker appdata path of MOS:
#   cd compose_ulrmm && docker-compose -f compose.yaml -f mos.override.yaml run --rm agents
ULRMM_AGENT_REPO=https://github.com/RiDDiX/ulrmm-agent.git
# time zone of every container
TZ=UTC
